<style>
  /* FORCED CSS BREAKOUT: Overrides Redmine's narrow parent administration tables */
  #settings table.plugin-settings,
  #settings table.plugin-settings tbody,
  #settings table.plugin-settings tr,
  #settings table.plugin-settings td {
    display: block !important;
    width: 100% !important;
    max-width: 100% !important;
    box-sizing: border-box !important;
    padding: 0 !important;
    margin: 0 !important;
    border: none !important;
  }

  .clean-dashboard-container {
    width: 100% !important;
    box-sizing: border-box;
    margin-top: 5px;
    clear: both !important;
  }

  /* Vertical List Sorter Blueprint layout rules */
  .vertical-sortable-list {
    list-style-type: none;
    padding: 0;
    margin: 5px 0 0 0;
    max-width: 650px;
  }

  .vertical-sort-item {
    background: #f9f9f9;
    border: 1px solid #ccc;
    border-radius: 4px;
    padding: 12px 18px;
    margin-bottom: 8px;
    cursor: grab;
    display: flex;
    justify-content: space-between;
    align-items: center;
    user-select: none;
    box-shadow: 0 1px 2px rgba(0,0,0,0.03);
    transition: background-color 0.2s;
  }

  .vertical-sort-item:active {
    cursor: grabbing;
  }

  .vertical-sort-item.dragging {
    opacity: 0.2;
    background: #e9e9e9;
    border-style: dashed;
  }

  /* Visual helper badges */
  .left-item-details {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .sequence-badge {
    background: #507aaa;
    color: #fff;
    font-weight: bold;
    font-size: 0.85em;
    padding: 2px 7px;
    border-radius: 12px;
    min-width: 18px;
    text-align: center;
  }

  .tab-key-tag {
    font-family: monospace;
    color: #666;
    background: #eee;
    padding: 2px 6px;
    border-radius: 3px;
    font-size: 0.85em;
  }
</style>

<div class="clean-dashboard-container">
  <%= text_field_tag 'settings[tab_order]', settings['tab_order'], id: 'settings_tab_order', style: 'display: none;' %>
  
  <ul class="vertical-sortable-list" id="project-tabs-sortable">
    <% 
      # 1. Dynamically gather all items currently registered across menus
      dynamic_tabs = {}
      [:project_menu, :application_menu].each do |menu_name|
        root_node = Redmine::MenuManager.items(menu_name)
        if root_node.respond_to?(:children) && root_node.children.present?
          root_node.children.each do |node|
            # Skip functional macro dropdowns or native creation items
            next if node.name == :new_object || node.name.to_s.start_with?('new_')

            # Fetch caption string using Redmine's layout engine evaluation
            caption_string = node.caption.is_a?(Symbol) ? l(node.caption) : node.caption.to_s
            dynamic_tabs[node.name.to_s] = caption_string.presence || node.name.to_s.humanize
          end
        end
      end

      # 2. Extract existing configuration arrays safely
      saved_order_string = settings['tab_order'].to_s
      configured_keys = saved_order_string.split(',').map(&:strip)

      # Filter configuration to keep only tabs that exist in the system right now
      ordered_view_keys = configured_keys.select { |k| dynamic_tabs.key?(k) }

      # Append newly discovered modules or third-party plugin tabs gracefully to the end
      dynamic_tabs.each_key { |k| ordered_view_keys << k unless ordered_view_keys.include?(k) }
    %>
    <% ordered_view_keys.each_with_index do |key, index| %>
      <li class="vertical-sort-item" draggable="true" data-key="<%= key %>">
        <div class="left-item-details">
          <span class="sequence-badge"><%= index + 1 %></span>
          <span><b>☰</b> <strong><%= I18n.t("project_tab_titles.#{key}", default: dynamic_tabs[key]) %></strong></span>
        </div>
        <span class="tab-key-tag"><%= key %></span>
      </li>
    <% end %>
  </ul>
</div>

<script>
  document.addEventListener("DOMContentLoaded", function() {
    const list = document.getElementById('project-tabs-sortable');
    const hiddenOrderInput = document.getElementById('settings_tab_order');
    const configForm = hiddenOrderInput.closest('form');

    function updateListState() {
      const items = list.querySelectorAll('.vertical-sort-item');
      const keys = [];
      
      items.forEach((item, index) => {
        keys.push(item.getAttribute('data-key'));
        const badge = item.querySelector('.sequence-badge');
        if (badge) {
          badge.textContent = index + 1;
        }
      });
      
      hiddenOrderInput.value = keys.join(',');
    }

    if (configForm) {
      configForm.addEventListener('submit', updateListState);
    }

    let draggedItem = null;
    list.addEventListener('dragstart', function(e) {
      draggedItem = e.target.closest('.vertical-sort-item');
      if (draggedItem) draggedItem.classList.add('dragging');
    });

    list.addEventListener('dragend', function(e) {
      if (draggedItem) {
        draggedItem.classList.remove('dragging');
        draggedItem = null;
        updateListState();
      }
    });

    list.addEventListener('dragover', function(e) {
      e.preventDefault();
      const afterElement = getDragAfterElement(list, e.clientY);
      const draggingElement = document.querySelector('.dragging');
      if (draggingElement) {
        if (afterElement == null) { list.appendChild(draggingElement); } 
        else { list.insertBefore(draggingElement, afterElement); }
      }
    });

    function getDragAfterElement(container, y) {
      const draggableElements = [...container.querySelectorAll('.vertical-sort-item:not(.dragging)')];
      return draggableElements.reduce((closest, child) => {
        const box = child.getBoundingClientRect();
        const offset = y - box.top - box.height / 2;
        if (offset < 0 && offset > closest.offset) { return { offset: offset, element: child }; } 
        else { return closest; }
      }, { offset: Number.NEGATIVE_INFINITY }).element;
    }
  });
</script>
